# =============================================================================
# Modèle de configuration (copie ce fichier en .env puis adapte les valeurs)
#   Windows (PowerShell) : Copy-Item .env.example .env
#   Linux / macOS        : cp .env.example .env
# Le fichier .env n'est JAMAIS versionné : il contient des secrets.
# Les valeurs ci-dessous correspondent à l'environnement Docker fourni
# (base et API accessibles depuis ton PC sur localhost).
# =============================================================================

# --- Base de données (PostgreSQL) -------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=analytics
DB_USER=pipeline_user
DB_PASSWORD=secure_password

# --- API des commandes ---------------------------------------------------------
# L'URL du cours (https://api.example.com/orders) n'existe pas : on utilise
# l'API simulée fournie dans mock_api/ (lancée par docker compose).
API_ENDPOINT=http://localhost:8000/orders
API_KEY=dev-api-key
API_TIMEOUT=30
API_MAX_RETRIES=3
API_BACKOFF_FACTOR=1.0
API_PAGE_SIZE=100
API_RATE_LIMIT_PER_SEC=5

# --- Chemins (relatifs à la racine du projet) ---------------------------------
INPUT_PATH=./data/input
OUTPUT_PATH=./data/output
STATE_PATH=./data/state
CHECKPOINT_PATH=./data/checkpoints

# --- Réglages du pipeline -----------------------------------------------------
BATCH_SIZE=1000
LOG_LEVEL=INFO
LOG_FILE=./logs/pipeline.log
# Moteur de calcul des agrégats de commandes : pandas (défaut) ou spark
ORDER_METRICS_ENGINE=pandas
CHECKPOINT_RETENTION_DAYS=7

# --- Alertes (facultatif) -----------------------------------------------------
# URL d'un webhook Slack / Teams / Discord pour recevoir les alertes
ALERT_WEBHOOK_URL=
# Adresse e-mail pour les alertes Airflow (nécessite un serveur SMTP configuré)
ALERT_EMAIL=
